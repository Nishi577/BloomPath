# AWS Configuration - copy to .env and fill in values after `sam deploy`
# Get these values from the SAM deploy output

# API Gateway URL (from SAM output: ApiUrl)
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod

# Cognito Configuration (from SAM output)
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# S3 Uploads Bucket (from SAM output: UploadsBucketName)
VITE_UPLOADS_BUCKET=bloompath-uploads-123456789012-us-east-1
